# Required Discord bot credentials
TOKEN=paste_your_discord_bot_token_here

# Custom Status Role feature
TARGET_STATUS=your target status phrase
# Comma-separated role IDs. ROLE_ID also accepts comma-separated IDs for compatibility.
ROLE_IDS=123456789012345678,234567890123456789
ROLE_ID=paste_the_target_role_id_here

# Optional persistent storage directory on Render
# DATA_DIR=/data

# Optional integrations used by existing cogs
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
NEON_DATABASE_URL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LAVALINK_PASSWORD=paste_lavalink_password_here
LAVALINK_URI=lavalink.lavaclient.xyz:80
LAVALINK_URL=http://lavalink.lavaclient.xyz:80
LAVALINK_PASSWORDS=paste_lavalink_password_here
LAVALINK_URIS=lavalink.lavaclient.xyz:80

# Optional control guild IDs used by some existing cogs
# ctrl_guild_id_0=
# ctrl_guild_id_1=
