generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  username  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  oauth     OAuthAccount?
  audits    DashboardAudit[]
}

model OAuthAccount {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenCipher  String
  refreshTokenCipher String
  expiresAt          DateTime
  scope              String
  updatedAt          DateTime @updatedAt
}

model ServerSettings {
  guildId         String   @id
  autoMod         Boolean  @default(true)
  antiLink        Boolean  @default(false)
  antiSpam        Boolean  @default(true)
  blacklistedWords String[] @default([])
  welcomeEnabled  Boolean  @default(false)
  welcomeMessage  String   @default("Welcome to {server}, {user}!")
  leaveMessage    String   @default("{user} has left the server.")
  welcomeChannelId String?
  aiEnabled       Boolean  @default(false)
  aiChannelId     String?
  economyEnabled  Boolean  @default(true)
  levelingEnabled Boolean  @default(true)
  statusRoleEnabled Boolean @default(false)
  targetStatus    String?
  statusRoleId    String?
  selfRoles       Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

model DashboardAudit {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  payload   Json
  createdAt DateTime @default(now())
  @@index([guildId, createdAt])
}
